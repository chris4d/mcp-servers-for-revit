; MCP Servers for Revit Installer - Generated by build-installer.ps1

[Setup]
AppName=MCP Servers for Revit
AppVersion=1.2.1
AppPublisher=MCP Servers for Revit
AppPublisherURL=https://github.com/chris4d/mcp-servers-for-revit
DefaultDirName={autopf}\MCP Servers for Revit
DefaultGroupName=MCP Servers for Revit
OutputDir=C:\dev\mcp-servers-for-revit\installer\output
OutputBaseFilename=mcp-servers-for-revit-setup
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
Source: "staged\2020\*"; DestDir: "{app}\RevitPlugins\2020"; Flags: recursesubdirs ignoreversion
Source: "staged\2021\*"; DestDir: "{app}\RevitPlugins\2021"; Flags: recursesubdirs ignoreversion
Source: "staged\2022\*"; DestDir: "{app}\RevitPlugins\2022"; Flags: recursesubdirs ignoreversion
Source: "staged\2023\*"; DestDir: "{app}\RevitPlugins\2023"; Flags: recursesubdirs ignoreversion
Source: "staged\2024\*"; DestDir: "{app}\RevitPlugins\2024"; Flags: recursesubdirs ignoreversion
Source: "staged\2025\*"; DestDir: "{app}\RevitPlugins\2025"; Flags: recursesubdirs ignoreversion
Source: "staged\2026\*"; DestDir: "{app}\RevitPlugins\2026"; Flags: recursesubdirs ignoreversion
Source: "staged\Server\*"; DestDir: "{app}\Server"; Flags: recursesubdirs ignoreversion
Source: "staged\node\node.exe"; DestDir: "{app}\node"; Flags: ignoreversion
Source: "run-mcp-server.cmd"; DestDir: "{app}\Server"; Flags: ignoreversion
Source: "opencode-config.ps1"; DestDir: "{app}\Installer"; Flags: ignoreversion
Source: "opencode-config.ps1"; DestDir: "{tmp}"; Flags: dontcopy

[Icons]
Name: "{group}\Uninstall MCP Servers for Revit"; Filename: "{uninstallexe}"

[Code]
const
  RevitRegKey = 'SOFTWARE\\Autodesk\\Revit\\Autodesk Revit ';
  ServerKey = 'mcp-server-for-revit';
  CommandSetFolder = 'revit_mcp_plugin\\Commands';

var
  Page: TWizardPage;
  SetPage: TWizardPage;
  ClaudeCB, CursorCB, OpencodeCB, OpenCode2CB, AnythingLLMCB: TNewCheckBox;
  OpenCodeVersion, OpenCodeSource, OpenCodeConfigShape: String;
  OpenCodeInstalled: Boolean;

var SetCBs: array[0..2] of TNewCheckBox;

function GetAppDataDir: String;
begin
  Result := GetEnv('APPDATA');
end;

function GetUserProfilePath: String;
begin
  Result := GetEnv('USERPROFILE');
end;

function GetOpenCodeConfigDir: String;
var D: String;
begin
  D := GetEnv('OPENCODE_CONFIG_DIR');
  if D <> '' then Result := D
  else begin
    D := GetEnv('XDG_CONFIG_HOME');
    if D <> '' then Result := D + '\opencode'
    else Result := GetUserProfilePath + '\.config\opencode';
  end;
end;

function DetectOpenCode: Boolean;
var RC: Integer; Script, OutFile, Line, Key, Value: String; SL: TStringList; I: Integer;
begin
  Result := False;
  OpenCodeInstalled := False;
  OpenCodeVersion := '';
  OpenCodeSource := 'none';
  OpenCodeConfigShape := 'none';
  try
    ExtractTemporaryFile('opencode-config.ps1');
  except
    Log('WARNING: could not extract opencode detection helper');
    Exit;
  end;
  Script := ExpandConstant('{tmp}\opencode-config.ps1');
  OutFile := ExpandConstant('{tmp}\opencode-detect.txt');
  if FileExists(OutFile) then DeleteFile(OutFile);
  if Exec('powershell.exe', '-NoProfile -ExecutionPolicy Bypass -File "' + Script + '" -Action Detect -OutputPath "' + OutFile + '"', '', SW_HIDE, ewWaitUntilTerminated, RC) then begin
    Log('opencode detection helper exit code: ' + IntToStr(RC));
    if (RC = 0) and FileExists(OutFile) then begin
      SL := TStringList.Create;
      try
        SL.LoadFromFile(OutFile);
        Log('opencode detection output lines: ' + IntToStr(SL.Count));
        for I := 0 to SL.Count - 1 do begin
          Line := SL[I];
          Log('opencode detect line: ' + Line);
          if Pos('=', Line) > 0 then begin
            Key := Copy(Line, 1, Pos('=', Line) - 1);
            Value := Copy(Line, Pos('=', Line) + 1, Length(Line));
            if Key = 'installed' then OpenCodeInstalled := Value = '1'
            else if Key = 'version' then OpenCodeVersion := Value
            else if Key = 'source' then OpenCodeSource := Value
            else if Key = 'config' then OpenCodeConfigShape := Value;
          end;
        end;
      finally SL.Free; end;
      Result := True;
    end else
      Log('WARNING: opencode detection output missing or helper failed: ' + OutFile);
  end else
    Log('WARNING: failed to launch opencode detection helper');
  if OpenCodeInstalled then
    Log('opencode detected: version=' + OpenCodeVersion + ' source=' + OpenCodeSource + ' config=' + OpenCodeConfigShape)
  else
    Log('opencode not detected');
end;

function RunOpenCodeConfig(ActionName: String; NativeMode: Boolean): Integer;
var RC: Integer; Params, Helper, Shim, Dir: String;
begin
  Result := 1;
  Helper := ExpandConstant('{app}\Installer\opencode-config.ps1');
  if not FileExists(Helper) then begin
    Log('WARNING: opencode config helper not found: ' + Helper);
    Exit;
  end;
  Dir := GetOpenCodeConfigDir;
  Shim := ExpandConstant('{app}\Server\run-mcp-server.cmd');
  Params := '-NoProfile -ExecutionPolicy Bypass -File "' + Helper + '" -Action ' + ActionName + ' -ConfigDir "' + Dir + '" -ShimPath "' + Shim + '" -LogPath "' + ExpandConstant('{tmp}\opencode-config.log') + '"';
  if NativeMode then Params := Params + ' -Native';
  if Exec('powershell.exe', Params, '', SW_HIDE, ewWaitUntilTerminated, RC) then begin
    Result := RC;
    Log('opencode config helper exit code: ' + IntToStr(RC));
  end else
    Log('WARNING: failed to launch opencode config helper');
end;

function IsRevitInstalled(Y: String): Boolean;
begin
  Result := RegKeyExists(HKLM, RevitRegKey + Y) or RegKeyExists(HKCU, RevitRegKey + Y);
end;

procedure PruneCommandSets(Src: String);
var CmdDir: String; I: Integer;
begin
  CmdDir := Src + '\\revit_mcp_plugin\\Commands';
  if not DirExists(CmdDir) then Exit;
  for I := 0 to High(SetCBs) do begin
    if not SetCBs[I].Checked then begin
      DelTree(CmdDir + '\\' + SetCBs[I].Caption, True, True, True);
      Log('Removed unselected command set: ' + SetCBs[I].Caption);
    end;
  end;
end;

// Assemble Commands\commandRegistry.json from the registry-entries.json
// fragments of the command sets the user kept selected. Skipped when the
// user already has a registry (their opt-ins are preserved).
procedure WriteCommandRegistry(Year: String);
var D, P, F, S, Entry: String; I: Integer; First: Boolean; Ch: Char; SL: TStringList;
begin
  D := GetAppDataDir + '\\Autodesk\\Revit\\Addins\\' + Year + '\\revit_mcp_plugin\\Commands';
  if not DirExists(D) then Exit;
  P := D + '\\commandRegistry.json';
  if FileExists(P) then Exit;
  S := '{"commands": [';
  First := True;
  for I := 0 to High(SetCBs) do
  begin
    if not SetCBs[I].Checked then Continue;
    F := D + '\\' + SetCBs[I].Caption + '\\registry-entries.json';
    if not FileExists(F) then Continue;
    SL := TStringList.Create;
    try
      SL.LoadFromFile(F);
      Entry := SL.Text;
    finally SL.Free; end;
    if (Length(Entry) >= 2) and (Entry[1] = '[') then Delete(Entry, 1, 1);
    while Length(Entry) > 0 do
    begin
      Ch := Entry[Length(Entry)];
      if (Ch = ']') or (Ch = #13) or (Ch = #10) then
        Delete(Entry, Length(Entry), 1)
      else
        Break;
    end;
    if Entry = '' then Continue;
    if not First then S := S + ',';
    S := S + Entry;
    First := False;
  end;
  S := S + ']}';
  SaveStringToFile(P, S, False);
  Log('Seeded command registry for ' + Year + ' from surviving set fragments');
end;

procedure CopyToRevitAddins(Year: String);
var Src, Dst: String; BAT: TStringList; RC: Integer; HadReg: Boolean;
begin
  Src := ExpandConstant('{app}\\RevitPlugins\\' + Year);
  Dst := GetAppDataDir + '\\Autodesk\\Revit\\Addins\\' + Year;
  if not DirExists(Src) then begin Log('Missing: ' + Src); Exit; end;
  PruneCommandSets(Src);
  ForceDirectories(Dst);
  // Preserve an existing command registry (user opt-ins) across reinstalls:
  // back it up before xcopy, restore after. Fresh installs get a registry
  // assembled from the surviving sets' fragments (all commands disabled).
  HadReg := FileExists(Dst + '\\revit_mcp_plugin\\Commands\\commandRegistry.json');
  if HadReg then
    if not CopyFile(Dst + '\\revit_mcp_plugin\\Commands\\commandRegistry.json', ExpandConstant('{tmp}\\cmdreg_' + Year + '.json'), False) then HadReg := False;
  BAT := TStringList.Create;
  try
    BAT.Add('@echo off');
    BAT.Add('xcopy "' + Src + '\\*" "' + Dst + '\\" /E /I /Y /Q');
    BAT.SaveToFile(ExpandConstant('{tmp}\\copy_' + Year + '.bat'));
  finally BAT.Free; end;
  Exec('cmd', '/c "' + ExpandConstant('{tmp}\\copy_' + Year + '.bat') + '"', '', SW_HIDE, ewWaitUntilTerminated, RC);
  if HadReg then
    CopyFile(ExpandConstant('{tmp}\\cmdreg_' + Year + '.json'), Dst + '\\revit_mcp_plugin\\Commands\\commandRegistry.json', False);
  if not HadReg then WriteCommandRegistry(Year);
  Log('Copied plugin to ' + Dst);
end;

procedure RemoveFromRevitAddins(Year: String);
var D: String;
begin
  D := GetAppDataDir + '\\Autodesk\\Revit\\Addins\\' + Year;
  if FileExists(D + '\\mcp-servers-for-revit.addin') then DeleteFile(D + '\\mcp-servers-for-revit.addin');
  if DirExists(D + '\\revit_mcp_plugin') then DelTree(D + '\\revit_mcp_plugin', True, True, True);
end;

procedure CleanTrailingCommas(var C: String);
var I, J: Integer;
begin
  for I := 1 to Length(C) do begin
    if C[I] = ',' then begin
      J := I + 1;
      while (J <= Length(C)) and ((C[J] = ' ') or (C[J] = #9) or (C[J] = #13) or (C[J] = #10)) do Inc(J);
      if (J <= Length(C)) and ((C[J] = '}') or (C[J] = ']')) then C[I] := ' ';
    end;
  end;
end;

// Structural JSON sanity for the four AI-client configs. The Pascal
// runtime has no JSON parser, so this checks the failure modes string
// surgery can actually produce: unbalanced braces (ignoring quoted
// values with backslash escapes), duplicate-key prefixes ("k": "k": {),
// and doubled commas.
function ConfigParseOK(C: String): Boolean;
var I, Depth: Integer; S, Bad: String; InQ, Esc: Boolean;
begin
  Result := False;
  S := Trim(C);
  if (S = '') or (S[1] <> '{') or (S[Length(S)] <> '}') then Exit;
  Bad := ServerKey + '": "' + ServerKey;
  if Pos(Bad, S) > 0 then Exit;
  if Pos(',,', S) > 0 then Exit;
  InQ := False; Esc := False; Depth := 0;
  for I := 1 to Length(S) do begin
    if Esc then begin Esc := False; Continue; end;
    if InQ then begin
      if S[I] = '\' then Esc := True
      else if S[I] = '"' then InQ := False;
      Continue;
    end;
    if S[I] = '"' then begin InQ := True; Continue; end;
    if S[I] = '{' then Depth := Depth + 1
    else if S[I] = '}' then begin
      Depth := Depth - 1;
      if Depth < 0 then Exit;
    end;
  end;
  if (Depth <> 0) or InQ then Exit;
  Result := True;
end;

// Saves a mutated config only if it still parses as JSON (structurally).
// On sanity failure the original file is left untouched, the reason is
// logged, and a warning dialog is shown.
procedure GuardedSaveConfig(SL: TStringList; P, C, Client: String);
begin
  CleanTrailingCommas(C);
  if ConfigParseOK(C) then begin
    SL.Text := C;
    SL.SaveToFile(P);
    Log('Saved ' + Client + ' config: ' + P);
  end else begin
    Log('WARNING: ' + Client + ' config edit rejected (would be invalid JSON); file left untouched: ' + P);
    SuppressibleMsgBox('Unable to update the ' + Client + ' AI-client config safely (the edit would produce invalid JSON). The existing file was left unchanged: ' + P + '. Please contact the developer at https://github.com/chris4d/mcp-servers-for-revit/issues and include the installer log.', mbError, MB_OK, IDOK);
  end;
end;

// Entry REMOVAL guard (uninstall path): same JSON sanity, generic messaging.
procedure GuardedRemoveConfig(SL: TStringList; P, C: String);
begin
  CleanTrailingCommas(C);
  if ConfigParseOK(C) then begin
    SL.Text := C;
    SL.SaveToFile(P);
    Log('Removed server entry from config: ' + P);
  end else begin
    Log('WARNING: config removal rejected (would be invalid JSON); file left untouched: ' + P);
    SuppressibleMsgBox('Unable to remove the MCP server entry from an AI-client config safely. The existing file was left unchanged: ' + P + '. Please contact the developer at https://github.com/chris4d/mcp-servers-for-revit/issues and include the installer log.', mbError, MB_OK, IDOK);
  end;
end;

// Path of the stdio launcher shim for this install, JSON-escaped (backslashes doubled).
function ShimPathJson(): String;
begin
  Result := ExpandConstant('{app}\Server\run-mcp-server.cmd');
  StringChangeEx(Result, '\', '\\', True);
end;

procedure GetNodeEntry(var Entry: String);
begin
  Entry := '"mcp-server-for-revit": {' + #13#10
         + '            "command": "cmd",' + #13#10
         + '            "args": ["/c", "' + ShimPathJson() + '"]' + #13#10
         + '        }';
end;

procedure GetOpenCodeEntry(var Entry: String);
begin
  Entry := '"mcp-server-for-revit": {' + #13#10
         + '            "type": "local",' + #13#10
         + '            "command": ["cmd", "/c", "' + ShimPathJson() + '"],' + #13#10
         + '            "enabled": true' + #13#10
         + '        }';
end;

procedure ReplaceNpxServerEntry(var C: String; OpenCodeStyle: Boolean);
var I, S, E, Depth: Integer; Block, Fresh: String;
begin
  S := Pos('"' + ServerKey + '"', C);
  if S = 0 then Exit;
  E := 0; Depth := 0;
  for I := S to Length(C) do begin
    if C[I] = '{' then begin
      Depth := Depth + 1;
    end else if C[I] = '}' then begin
      Depth := Depth - 1;
      if Depth = 0 then begin E := I; Break; end;
    end;
  end;
  if E = 0 then Exit;
  Block := Copy(C, S, E - S + 1);
  // Upgrade stale entry forms: npx-based (upstream era) and direct "node"
  // launches (pre-bundled-runtime installs) both become shim-based.
  if (Pos('npx', Block) = 0) and (Pos('run-mcp-server', Block) > 0) then Exit;
  if OpenCodeStyle then GetOpenCodeEntry(Fresh) else GetNodeEntry(Fresh);
  Delete(C, S, E - S + 1);
  Insert(Fresh, C, S);
  Log('Refreshed server entry to bundled-runtime shim');
end;

procedure ConfigureClaudeDesktop;
var P, C: String; SL: TStringList;
begin
  P := GetAppDataDir + '\\Claude\\claude_desktop_config.json';
  if not FileExists(P) then begin
    ForceDirectories(ExtractFilePath(P));
    SL := TStringList.Create;
    try
      SL.Add('{');
      SL.Add('    "mcpServers": {');
      SL.Add('        "mcp-server-for-revit": {');
      SL.Add('            "command": "cmd",');
      SL.Add('            "args": ["/c", "' + ShimPathJson() + '"]');
      SL.Add('        }');
      SL.Add('    }');
      SL.Add('}');
      GuardedSaveConfig(SL, P, SL.Text, 'Claude Desktop');
    finally SL.Free; end;
    Log('Created Claude Desktop config');
  end else begin
    SL := TStringList.Create;
    try
      SL.LoadFromFile(P); C := SL.Text;
      if Pos(ServerKey, C) > 0 then begin
        ReplaceNpxServerEntry(C, False);
        GuardedSaveConfig(SL, P, C, 'Claude Desktop');
      Exit;
      end;
      StringChangeEx(C, '"mcpServers": {',
        '"mcpServers": {' + #13#10 + '        "mcp-server-for-revit": {' + #13#10 + '            "command": "cmd",' + #13#10 + '            "args": ["/c", "' + ShimPathJson() + '"]' + #13#10 + '        },', True);
      GuardedSaveConfig(SL, P, C, 'Claude Desktop');
    finally SL.Free; end;
  end;
end;

procedure RemoveFromClaudeDesktop;
var P, C, Block: String; SL: TStringList; S, E: Integer;
begin
  P := GetAppDataDir + '\\Claude\\claude_desktop_config.json';
  if not FileExists(P) then Exit;
  SL := TStringList.Create;
  try
    SL.LoadFromFile(P); C := SL.Text;
    S := Pos('"mcp-server-for-revit"', C);
    if S = 0 then Exit;
    E := Pos('}', Copy(C, S, Length(C)));
    if E = 0 then Exit;
    E := S + E - 1;
    if (E + 1 <= Length(C)) and (C[E + 1] = ',') then Inc(E);
    Block := Copy(C, S, E - S + 1);
    if Pos(ShimPathJson(), Block) = 0 then begin
      Log('Claude Desktop entry is not owned by this installer; left untouched');
      Exit;
    end;
    Delete(C, S, E - S + 1);
    CleanTrailingCommas(C);
    GuardedRemoveConfig(SL, P, C);
  finally SL.Free; end;
end;

